# Promotional video source is kept; captured media and rendered outputs are generated.
/promo-output/*

# Runtime state and user media must never enter source control.
.work/
song-library/
*.mp3
*.wav
*.flac
*.m4a
*.mp4
!docs/assets/dx-band-demo.mp4
!src/dxband/resources/background_videos/Cieling_Flames_1080p_Loop.mp4
!src/dxband/resources/background_videos/Ethereal_Wave_1080p_Loop.mp4
!src/dxband/resources/background_videos/Macro_Plex_1080p_Loop.mp4
*.aac
*.ogg
*.mov
*.webm
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.zip
.*-raw-analysis/

!/promo-output/ruyuan-demo/
/promo-output/ruyuan-demo/*
